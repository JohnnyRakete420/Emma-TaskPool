<Window x:Class="Emma.Viewer.AufgabeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aufgabendetails" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Icon="Icon.ico">
    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#93C003" BlurRadius="24" ShadowDepth="0" Opacity="0.18" />
        </Border.Effect>
        <StackPanel Margin="28">
            <TextBlock x:Name="ProzessNameText" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="Werte für diese Aufgabe:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

            <ItemsControl x:Name="FelderItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource MintBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Bezeichnung}" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Wert}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Werte übernommen – weiter" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="WeiterButton_Click" />
        </StackPanel>
    </Border>
</Window>
