<Window x:Class="Emma.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EMMA - Aufgabenpool" Height="700" Width="820" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Icon="Icon.ico">
    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#93C003" BlurRadius="24" ShadowDepth="0" Opacity="0.18" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Offene Aufgaben für EMMA" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AufgabenListe">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource PastelGreenBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,4,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#93C003" BlurRadius="14" ShadowDepth="0" Opacity="0.10" />
                                </Border.Effect>
                                <StackPanel>

                                    <!-- Kopfzeile: Prozessname + Status-Badge -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProzessName}" FontSize="24" FontWeight="Bold" />
                                            <TextBlock Text="{Binding ErstelltInfo}" FontSize="13" Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="1" CornerRadius="999" Padding="16,8" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SoftGreenBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="Wird bearbeitet">
                                                            <Setter Property="Background" Value="{StaticResource GreenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="Wird bearbeitet">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Formularfelder: ein großer, klar beschrifteter Block je Feld -->
                                    <ItemsControl ItemsSource="{Binding ParameterWerte}" Margin="0,18,0,0">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HatParameter}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource MintBrush}" CornerRadius="8"
                                                        Padding="14,9" Margin="0,0,12,12" MinWidth="140">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Bezeichnung}" FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Wert}" FontSize="19"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Aktionen -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                        <Button Content="Bearbeiten" Padding="16,9" FontSize="13" Margin="0,0,10,0"
                                                Click="BearbeitenButton_Click" Tag="{Binding Id}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ZeigeBearbeiten}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Erledigt" Style="{StaticResource PrimaryButton}"
                                                Padding="18,9" FontSize="13" Margin="0,0,10,0"
                                                Click="ErledigtButton_Click" Tag="{Binding Id}" />
                                        <Button Content="Fehlgeschlagen" Style="{StaticResource SecondaryButton}"
                                                Padding="16,9" FontSize="13"
                                                Click="FehlgeschlagenButton_Click" Tag="{Binding Id}" />
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,16,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
        </Grid>
    </Border>
</Window>
