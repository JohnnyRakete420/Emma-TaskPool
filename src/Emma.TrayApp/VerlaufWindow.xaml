<Window x:Class="Emma.TrayApp.VerlaufWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verlauf &amp; Übersicht" Height="720" Width="1000" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Icon="Icon.ico" Style="{StaticResource FensterChrome}">
    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#93C003" BlurRadius="24" ShadowDepth="0" Opacity="0.18" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="Aktualisieren" Style="{StaticResource SecondaryButton}"
                        Click="AktualisierenButton_Click" />
                <TextBlock Text="Verlauf &amp; Übersicht" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Erfolgsquote: ein Dropdown steuert Kacheln + Tabelle darunter -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Erfolgsquote je Prozess" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <ComboBox x:Name="ProzessFilterComboBox" Width="240" HorizontalAlignment="Left"
                          SelectionChanged="ProzessFilter_SelectionChanged" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="{StaticResource MintBrush}" CornerRadius="10" Padding="18,12" Margin="0,0,12,0" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="Gesamt" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="GesamtText" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource MintBrush}" CornerRadius="10" Padding="18,12" Margin="0,0,12,0" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="Erledigt" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="ErledigtText" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource MintBrush}" CornerRadius="10" Padding="18,12" Margin="0,0,12,0" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="Fehlgeschlagen" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="FehlgeschlagenText" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SoftGreenBrush}" CornerRadius="10" Padding="18,12" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="Erfolgsquote" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="ErfolgsquoteText" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <WrapPanel Grid.Row="3" Margin="0,0,0,14">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Status" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox x:Name="StatusFilterComboBox" Width="140" SelectionChanged="Filter_SelectionChanged" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Von" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <DatePicker x:Name="VonDatePicker" Width="130" SelectedDateChanged="Filter_DateChanged" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Bis" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <DatePicker x:Name="BisDatePicker" Width="130" SelectedDateChanged="Filter_DateChanged" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Suche (erstellt von)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="SucheTextBox" Width="120" TextChanged="Filter_TextChanged" />
                </StackPanel>
            </WrapPanel>

            <TextBlock Grid.Row="4" Text="Doppelklick auf eine Zeile zeigt alle Details" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />

            <DataGrid Grid.Row="5" x:Name="HistorieGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      MouseDoubleClick="HistorieGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Prozess" Binding="{Binding ProzessName}" Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                    <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterText}" Width="*" MinWidth="200" />
                    <DataGridTextColumn Header="Erstellt am" Binding="{Binding ErstelltAm}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="6" x:Name="StatusText" Margin="0,12,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
        </Grid>
    </Border>
</Window>
