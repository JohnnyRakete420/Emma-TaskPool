<Window x:Class="Emma.TrayApp.ProzesseVerwaltenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prozesse verwalten" Height="560" Width="700" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Icon="Icon.ico">
    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#93C003" BlurRadius="24" ShadowDepth="0" Opacity="0.18" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Neu" Style="{StaticResource PrimaryButton}"
                        Padding="20,9" Click="NeuButton_Click" />
                <TextBlock Text="Prozesse verwalten" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>

            <DataGrid Grid.Row="1" x:Name="ProzesseGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
                    <DataGridTextColumn Header="Beschreibung" Binding="{Binding Beschreibung}" Width="2*" MinWidth="180" />
                    <DataGridTextColumn Header="Formularfelder" Binding="{Binding FelderText}" Width="120" />
                    <DataGridTemplateColumn Header="" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Bearbeiten" Style="{StaticResource SecondaryButton}"
                                        Click="BearbeitenButton_Click" Tag="{Binding Id}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,12,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
