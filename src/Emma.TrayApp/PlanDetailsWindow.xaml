<Window x:Class="Emma.TrayApp.PlanDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plandetails" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterScreen"
        Icon="Icon.ico">
    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#93C003" BlurRadius="24" ShadowDepth="0" Opacity="0.18" />
        </Border.Effect>
        <StackPanel Margin="28">
            <TextBlock x:Name="ProzessNameText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />

            <TextBlock Text="Wochentage &amp; Uhrzeiten" FontSize="12" Margin="0,18,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <ItemsControl x:Name="ZeitpunkteItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource MintBrush}" CornerRadius="8" Padding="14,9" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Wochentag}" FontWeight="SemiBold" FontSize="15" Width="110" />
                                <TextBlock Text="{Binding Uhrzeit}" FontSize="15" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="ParameterItemsControl" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SoftGreenBrush}" CornerRadius="8" Padding="14,9" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Bezeichnung}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Wert}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Schließen" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Margin="0,18,0,0" Click="SchliessenButton_Click" />
        </StackPanel>
    </Border>
</Window>
