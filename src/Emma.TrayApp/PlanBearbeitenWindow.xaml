<Window x:Class="Emma.TrayApp.PlanBearbeitenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan" Height="760" Width="560" MinWidth="500" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="Icon.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#93C003" BlurRadius="24" ShadowDepth="0" Opacity="0.18" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitelText" Text="Plan" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Prozess" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="ProzessComboBox" DisplayMemberPath="Name" Margin="0,0,0,20"
                              SelectionChanged="ProzessComboBox_SelectionChanged" />

                    <TextBlock Text="Wochentage &amp; Uhrzeiten" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ItemsControl x:Name="TageItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource PastelGreenBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="TagCheckBox" Content="{Binding Anzeigename}"
                                                  IsChecked="{Binding IstAktiv}" FontWeight="SemiBold" FontSize="14"
                                                  Click="TagCheckBox_Click" />
                                        <WrapPanel Margin="26,8,0,0"
                                                   Visibility="{Binding IsChecked, ElementName=TagCheckBox, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding Zeiten}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource MintBrush}" CornerRadius="6"
                                                                Margin="0,0,8,8" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox Text="{Binding Wert, UpdateSourceTrigger=PropertyChanged}"
                                                                         Width="46" MinWidth="46" BorderThickness="0" Background="Transparent"
                                                                         TextAlignment="Center" Padding="0" ToolTip="HH:mm" />
                                                                <Button Content="✕" Width="22" Height="22" Padding="0" FontSize="11"
                                                                        Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"
                                                                        Click="ZeitEntfernen_Click" Tag="{Binding}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="+ Uhrzeit" Style="{StaticResource SecondaryButton}"
                                                    Padding="10,4" FontSize="12" Margin="0,0,0,8"
                                                    Click="ZeitHinzufuegen_Click" Tag="{Binding}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="ParameterPanel" Visibility="Collapsed" Margin="0,20,0,0">
                        <TextBlock Text="Parameter" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ItemsControl x:Name="ParameterItemsControl"
                                      ItemTemplateSelector="{StaticResource ParameterFeldTemplateSelector}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,12,0,10" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />

            <DockPanel Grid.Row="3">
                <Button x:Name="LoeschenButton" DockPanel.Dock="Left" Content="Plan löschen"
                        Style="{StaticResource SecondaryButton}" Padding="14,9" Visibility="Collapsed"
                        Click="LoeschenButton_Click" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Padding="16,9"
                            Margin="0,0,10,0" Click="AbbrechenButton_Click" />
                    <Button Content="Speichern" Style="{StaticResource PrimaryButton}" Padding="20,9"
                            Click="SpeichernButton_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
