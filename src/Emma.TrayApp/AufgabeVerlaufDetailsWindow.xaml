<Window x:Class="Emma.TrayApp.AufgabeVerlaufDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aufgabendetails" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterScreen"
        Icon="Icon.ico">
    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#93C003" BlurRadius="24" ShadowDepth="0" Opacity="0.18" />
        </Border.Effect>
        <StackPanel Margin="28">
            <TextBlock x:Name="ProzessNameText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
            <Border x:Name="StatusBadge" Background="{StaticResource SoftGreenBrush}" CornerRadius="999"
                    Padding="14,6" HorizontalAlignment="Left" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="13" />
            </Border>

            <Border x:Name="FehlermeldungPanel" Background="#FBEAEA" CornerRadius="8" Padding="14,10" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Fehlermeldung" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="FehlermeldungText" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="ParameterItemsControl" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource MintBrush}" CornerRadius="8" Padding="14,9" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Bezeichnung}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Wert}" FontSize="17" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,16,0,0">
                <TextBlock FontSize="13" Margin="0,0,0,4">
                    <Run Text="Erstellt von: " Foreground="{StaticResource TextSecondaryBrush}" />
                    <Run x:Name="ErstelltVonRun" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock FontSize="13" Margin="0,0,0,4">
                    <Run Text="Erstellt am: " Foreground="{StaticResource TextSecondaryBrush}" />
                    <Run x:Name="ErstelltAmRun" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock x:Name="AbgeschlossenAmPanel" FontSize="13">
                    <Run Text="Abgeschlossen am: " Foreground="{StaticResource TextSecondaryBrush}" />
                    <Run x:Name="AbgeschlossenAmRun" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>

            <Button Content="Schließen" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Margin="0,18,0,0" Click="SchliessenButton_Click" />
        </StackPanel>
    </Border>
</Window>
