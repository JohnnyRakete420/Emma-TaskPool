<Window x:Class="Emma.TrayApp.EinstellungenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterScreen"
        Icon="Icon.ico" Style="{StaticResource FensterChrome}">
    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#93C003" BlurRadius="24" ShadowDepth="0" Opacity="0.18" />
        </Border.Effect>
        <StackPanel Margin="28">
            <TextBlock Text="Einstellungen" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Gelten nur für diesen Rechner." FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20" />

            <CheckBox x:Name="AutostartCheckBox" Content="Beim Anmelden starten"
                      FontSize="14" Margin="0,0,0,14" Click="AutostartCheckBox_Click" />

            <CheckBox x:Name="BenachrichtigungenCheckBox"
                      FontSize="14" Margin="0,0,0,4" Click="BenachrichtigungenCheckBox_Click"
                      HorizontalContentAlignment="Stretch">
                <TextBlock Text="Benachrichtigungen anzeigen, wenn EMMA eine Aufgabe abschließt"
                           TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="Windows-Sprechblase bei Erfolg oder Fehlschlag." FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="26,0,0,14" TextWrapping="Wrap" />

            <CheckBox x:Name="DarkModeCheckBox" Content="Dunkles Design"
                      FontSize="14" Margin="0,0,0,4" Click="DarkModeCheckBox_Click" />
            <TextBlock Text="Wirkt sich erst nach einem Neustart der Anwendung aus." FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="26,0,0,20" TextWrapping="Wrap" />

            <Border BorderBrush="{StaticResource PastelGreenBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Server-Verbindung" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <TextBlock Text="Server-Adresse" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="ServerUrlTextBox" Margin="0,0,0,10" />

                    <TextBlock Text="API-Key" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="ApiKeyTextBox" Margin="0,0,0,10" />

                    <TextBlock Text="Zertifikats-Thumbprint" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="ZertifikatTextBox" Margin="0,0,0,4" />
                    <TextBlock Text="Alle drei Werte stehen auf dem EMMA-Rechner in 'fuer-clients.json'." FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="VerbindungTestenButton" Content="Verbindung testen"
                                Style="{StaticResource SecondaryButton}" Padding="14,8" Click="VerbindungTestenButton_Click" />
                        <Button Content="Speichern" Style="{StaticResource PrimaryButton}" Padding="14,8"
                                Margin="0,0,10,0" Click="VerbindungSpeichernButton_Click" />
                    </DockPanel>
                    <TextBlock x:Name="VerbindungStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border BorderBrush="{StaticResource PastelGreenBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>

            <Button Content="Schließen" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Margin="0,20,0,0" Click="SchliessenButton_Click" />
        </StackPanel>
    </Border>
</Window>
